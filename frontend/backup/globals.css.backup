
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

@import "tailwindcss";

:root {
  --navy: #172f4a;
  --navy-deep: #10263e;
  --blue: #315e83;
  --blue-light: #e8eef3;
  --gold: #aa9169;
  --ink: #263748;
  --muted: #788692;
  --line: #e2e7eb;
  --paper: #f6f7f7;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

body {
  margin: 0;
  color: var(--ink);
  background: var(--paper);
  font-family: "DM Sans", sans-serif;
  -webkit-font-smoothing: antialiased;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  font: inherit;
}

.site-shell {
  overflow: hidden;
  width: 100%;
}

.announcement {
  height: 33px;
  padding: 0 7%;
  background: var(--navy);
  color: #e5ebf0;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 1.5px;
}

.announcement-dot {
  height: 5px;
  width: 5px;
  background: #c4ae88;
  border-radius: 50%;
}

.announcement-right {
  margin-left: auto;
  color: #aab9c6;
  font-size: 8px;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  height: 91px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,.94);
  border-bottom: 1px solid #e8ecef;
  backdrop-filter: blur(16px);
  transition: box-shadow .3s, height .3s;
}

.header-scrolled {
  height: 76px;
  box-shadow: 0 8px 30px #172f4a0b;
}

.logo-wrap {
  display: flex;
  align-items: center;
  width: 180px;
}

.brand-logo {
  display: block;
  width: 100%;
  height: auto;
  max-height: 65px;
  object-fit: contain;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 35px;
}

.main-nav a {
  font-size: 11px;
  font-weight: 600;
  color: #627180;
  transition: color .2s;
}

.main-nav a:hover {
  color: var(--blue);
}

.header-cta {
  display: inline-flex;
  align-items: center;
  gap: 23px;
  padding: 13px 18px;
  border: 1px solid #d4dce3;
  color: var(--navy);
  font-size: 11px;
  font-weight: 700;
  transition: .25s;
}

.header-cta:hover {
  background: var(--navy);
  color: white;
  border-color: var(--navy);
}

.header-cta span {
  color: var(--gold);
}

.mobile-menu-button,
.mobile-contact {
  display: none;
}

/* HERO */

.hero-section {
  min-height: 700px;
  position: relative;
  display: grid;
  grid-template-columns: 1.03fr .97fr;
  align-items: center;
  padding: 65px 7% 105px;
  background:
    radial-gradient(ellipse at 79% 44%, #e4eaf0 0%, transparent 43%),
    linear-gradient(115deg, #fff 0%, #f7f8f8 56%, #eff2f4 100%);
}

.hero-grain {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .12;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E");
}

.hero-copy {
  position: relative;
  z-index: 2;
  max-width: 590px;
  padding-bottom: 10px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--blue);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2.1px;
}

.eyebrow-rule {
  display: inline-block;
  height: 1px;
  width: 31px;
  background: var(--gold);
}

.hero-copy h1 {
  margin: 29px 0 25px;
  font-family: "Manrope", sans-serif;
  color: var(--navy);
  font-size: clamp(53px, 6.2vw, 82px);
  font-weight: 700;
  letter-spacing: -5px;
  line-height: 1.04;
}

.hero-copy h1 span {
  color: var(--blue);
}

.hero-lead {
  max-width: 465px;
  color: #758391;
  font-size: 14px;
  line-height: 2;
  font-weight: 400;
}

.hero-buttons {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 33px;
}

.button-primary {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding: 17px 21px;
  background: var(--navy);
  color: white;
  font-size: 11px;
  font-weight: 600;
  border: 1px solid var(--navy);
  transition: background .3s, transform .3s, box-shadow .3s;
}

.button-primary:hover {
  background: var(--blue);
  border-color: var(--blue);
  transform: translateY(-3px);
  box-shadow: 0 12px 25px #172f4a20;
}

.button-primary span {
  color: #d2bd98;
}

.button-quiet {
  color: var(--navy);
  font-size: 11px;
  font-weight: 700;
}

.button-quiet span {
  color: var(--gold);
  padding-left: 8px;
}

.hero-proof {
  margin-top: 63px;
  display: flex;
  align-items: center;
  gap: 13px;
}

.proof-mark {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  background: var(--blue-light);
  color: var(--navy);
  font-family: "Manrope", sans-serif;
  font-weight: 800;
  font-size: 17px;
}

.hero-proof div:last-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hero-proof strong {
  color: var(--navy);
  font-size: 9px;
  letter-spacing: 1.6px;
}

.hero-proof span {
  color: #87939d;
  font-size: 8px;
  letter-spacing: 1.4px;
}

/* CSS 3D ARTWORK */

.hero-art {
  position: relative;
  height: 505px;
  min-width: 0;
  perspective: 1200px;
}

.art-top-label,
.art-bottom-label {
  position: absolute;
  left: 2%;
  right: 2%;
  display: flex;
  justify-content: space-between;
  color: #8b99a5;
  font-size: 8px;
  letter-spacing: 1.6px;
  font-weight: 600;
}

.art-top-label {
  top: 13px;
}

.art-bottom-label {
  bottom: 12px;
}

.art-coordinates {
  color: var(--gold);
}

.art-stage {
  position: absolute;
  inset: 35px 0;
  display: grid;
  place-items: center;
  transform-style: preserve-3d;
  animation: stageFloat 8s ease-in-out infinite;
}

.stage-shadow {
  position: absolute;
  width: 65%;
  height: 22%;
  left: 17%;
  bottom: 13%;
  border-radius: 50%;
  background: #52677a20;
  filter: blur(23px);
  transform: rotateX(72deg);
}

.stage-ring {
  position: absolute;
  width: 370px;
  height: 370px;
  border-radius: 50%;
  border: 1px solid #8da0b166;
  transform: rotateX(69deg) rotateZ(-24deg);
}

.stage-ring-back {
  width: 430px;
  height: 430px;
  border-color: #b5a17f66;
  transform: rotateX(69deg) rotateZ(27deg);
}

.stage-ring-front {
  border-style: dashed;
  border-color: #9daebb77;
  animation: ringRotate 32s linear infinite;
}

.sculpture {
  position: relative;
  z-index: 3;
  width: 210px;
  height: 235px;
  transform-style: preserve-3d;
  transform: rotateY(-30deg) rotateX(13deg) rotateZ(-8deg);
  animation: sculptureFloat 7s ease-in-out infinite;
}

.sculpture-face {
  position: absolute;
  inset: 0;
  background: linear-gradient(140deg, #69839a 0%, #31536f 27%, #17334f 65%, #10253b 100%);
  clip-path: polygon(20% 0, 100% 0, 80% 100%, 0 100%);
  box-shadow: inset 12px 10px 20px #ffffff35;
  overflow: hidden;
}

.sculpture-side {
  position: absolute;
  top: 0;
  right: -22px;
  width: 45px;
  height: 100%;
  background: linear-gradient(90deg, #18344f, #0d2136);
  transform: skewY(-12deg);
  filter: brightness(.8);
}

.sculpture-top {
  position: absolute;
  top: -19px;
  left: 20%;
  width: 80%;
  height: 40px;
  background: linear-gradient(90deg, #d1dbe2, #8fa5b5);
  transform: skewX(-60deg) rotateX(58deg);
  opacity: .9;
}

.sculpture-cutout {
  position: absolute;
  width: 76px;
  height: 105px;
  border-radius: 50% 50% 5px 5px;
  border: 12px solid #d6e0e6;
  border-bottom: 0;
  left: 35%;
  top: 34%;
  transform: rotate(1deg);
  box-shadow: 0 0 0 1px #ffffff55, inset 0 0 20px #091c2d88;
}

.sculpture-highlight {
  position: absolute;
  left: 20%;
  top: 0;
  height: 100%;
  width: 2px;
  background: #ffffff40;
  transform: rotate(1deg);
}

.art-orb {
  position: absolute;
  border-radius: 50%;
  z-index: 4;
}

.orb-large {
  width: 56px;
  height: 56px;
  right: 13%;
  top: 17%;
  background: radial-gradient(circle at 30% 25%, #ffffff, #d4dce1 35%, #8b9da9 75%, #536c7e);
  box-shadow: 9px 13px 20px #52687c35, inset -6px -7px 12px #6e829055;
  animation: orbFloat 6s ease-in-out infinite;
}

.orb-small {
  width: 19px;
  height: 19px;
  left: 15%;
  bottom: 25%;
  background: radial-gradient(circle at 30% 30%, #fff, #b59b73 55%, #826c4e);
  box-shadow: 0 8px 16px #7e684a44;
  animation: orbFloat 5s ease-in-out infinite reverse;
}

.art-disc {
  position: absolute;
  width: 88px;
  height: 88px;
  bottom: 15%;
  right: 20%;
  border-radius: 50%;
  border: 13px solid #c2ccd3;
  border-left-color: #758b9d;
  border-bottom-color: #9baab5;
  transform: rotateX(65deg) rotateZ(22deg);
  box-shadow: 0 10px 22px #344b6025;
}

.art-crosshair {
  position: absolute;
  font-size: 20px;
  color: var(--gold);
  font-weight: 300;
}

.crosshair-one {
  top: 18%;
  left: 16%;
}

.crosshair-two {
  bottom: 17%;
  right: 10%;
  color: #8da0b1;
}

.art-axis {
  position: absolute;
  width: 1px;
  height: 75%;
  background: linear-gradient(transparent, #b7c3cc, transparent);
}

.axis-one {
  transform: rotate(37deg);
}

.axis-two {
  transform: rotate(-37deg);
  opacity: .5;
}

@keyframes stageFloat {
  0%, 100% { transform: translateY(0) rotateX(0); }
  50% { transform: translateY(-10px) rotateX(2deg); }
}

@keyframes sculptureFloat {
  0%, 100% { transform: translateY(0) rotateY(-30deg) rotateX(13deg) rotateZ(-8deg); }
  50% { transform: translateY(-12px) rotateY(-24deg) rotateX(17deg) rotateZ(-5deg); }
}

@keyframes ringRotate {
  from { transform: rotateX(69deg) rotateZ(0deg); }
  to { transform: rotateX(69deg) rotateZ(360deg); }
}

@keyframes orbFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

.hero-footer-line {
  position: absolute;
  bottom: 26px;
  left: 7%;
  right: 7%;
  display: flex;
  justify-content: space-between;
  color: #84919c;
  font-size: 8px;
  letter-spacing: 1.6px;
  font-weight: 600;
}

.scroll-arrow {
  color: var(--gold);
  padding-left: 8px;
}

/* CAPABILITY STRIP */

.capability-strip {
  min-height: 95px;
  padding: 24px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
  background: #fff;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.capability-heading {
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.7px;
  color: var(--gold);
}

.capability-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 10px;
  font-weight: 600;
  color: #536476;
}

.capability-index {
  color: #a0aab3;
  font-size: 8px;
}

/* ABOUT */

.section-pad {
  padding-left: 9%;
  padding-right: 9%;
}

.about-section {
  padding-top: 135px;
  padding-bottom: 135px;
  display: grid;
  grid-template-columns: .55fr 1.45fr;
  gap: 65px;
  background: #f8f9f9;
}

.section-index {
  color: var(--gold);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.6px;
}

.about-aside {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.aside-decoration {
  font-family: "Manrope", sans-serif;
  font-size: 135px;
  font-weight: 800;
  letter-spacing: -13px;
  color: #e9edf0;
  line-height: .8;
}

.about-main .eyebrow {
  margin-bottom: 25px;
}

.about-main h2,
.services-heading h2,
.contact-copy h2 {
  font-family: "Manrope", sans-serif;
  font-size: clamp(35px, 4.5vw, 57px);
  font-weight: 700;
  letter-spacing: -2.6px;
  line-height: 1.18;
  color: var(--navy);
  margin: 0;
}

.about-main h2 span,
.services-heading h2 span,
.contact-copy h2 span {
  color: var(--blue);
}

.about-bottom {
  margin-top: 35px;
  padding-top: 27px;
  border-top: 1px solid #dfe5e9;
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 35px;
}

.about-bottom p {
  max-width: 470px;
  color: var(--muted);
  font-size: 13px;
  line-height: 2;
  margin: 0;
}

.underlined-link {
  white-space: nowrap;
  padding-bottom: 7px;
  border-bottom: 1px solid #b7a17f;
  font-size: 10px;
  font-weight: 700;
  color: var(--navy);
}

.underlined-link span {
  color: var(--gold);
  margin-left: 8px;
}

/* SERVICES */

.services-section {
  padding-top: 120px;
  padding-bottom: 130px;
  background: #edf1f4;
}

.services-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 50px;
  margin-bottom: 60px;
}

.services-heading h2 {
  margin-top: 24px;
}

.services-heading > p {
  max-width: 290px;
  margin: 0 0 6px;
  color: var(--muted);
  font-size: 12px;
  line-height: 2;
}

.services-list {
  border-top: 1px solid #d3dce3;
}

.service-row {
  min-height: 175px;
  display: grid;
  grid-template-columns: 65px 100px 1fr 55px;
  align-items: center;
  gap: 22px;
  padding: 25px 18px;
  border-bottom: 1px solid #d3dce3;
  transition: background .3s, padding .3s;
}

.service-row:hover {
  background: #f8fafb;
  padding-left: 28px;
  padding-right: 28px;
}

.service-no {
  align-self: start;
  padding-top: 17px;
  color: #9ba7b1;
  font-size: 10px;
}

.service-symbol {
  width: 75px;
  height: 75px;
  display: grid;
  place-items: center;
  border: 1px solid #d0dbe3;
  background: linear-gradient(145deg, #fff, #e4eaf0);
  color: var(--blue);
  font-size: 32px;
  box-shadow: 7px 8px 18px #2637480c;
  transition: transform .3s;
}

.service-row:hover .service-symbol {
  transform: rotate(-7deg) translateY(-4px);
}

.service-category {
  color: var(--gold);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.6px;
}

.service-content h3 {
  color: var(--navy);
  font-family: "Manrope", sans-serif;
  font-size: 23px;
  font-weight: 700;
  margin: 9px 0;
  letter-spacing: -.7px;
}

.service-content p {
  max-width: 530px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.8;
  margin: 0;
}

.service-link {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid #d1dce3;
  border-radius: 50%;
  color: var(--navy);
  font-size: 18px;
  transition: .3s;
}

.service-link:hover {
  background: var(--navy);
  color: white;
  transform: rotate(45deg);
}

/* STATEMENT */

.statement-section {
  position: relative;
  padding: 55px 9% 40px;
  min-height: 570px;
  background:
    radial-gradient(ellipse at 85% 55%, #31506b 0%, transparent 40%),
    linear-gradient(110deg, #172f4a, #213e5a);
  color: white;
  overflow: hidden;
}

.statement-section::after {
  content: "N";
  position: absolute;
  right: 4%;
  top: -95px;
  font-family: "Manrope", sans-serif;
  font-size: 570px;
  line-height: 1;
  font-weight: 800;
  color: #ffffff08;
  pointer-events: none;
}

.statement-top,
.statement-bottom {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.statement-top .section-index {
  color: #c2ab83;
}

.statement-caption,
.statement-bottom {
  color: #b7c5d0;
  font-size: 8px;
  letter-spacing: 1.8px;
}

.statement-content {
  position: relative;
  z-index: 2;
  max-width: 790px;
  margin: 80px auto 70px;
}

.statement-mark {
  color: #bba57e;
  font-family: Georgia, serif;
  font-size: 90px;
  height: 55px;
  line-height: 1;
}

.statement-content h2 {
  font-family: "Manrope", sans-serif;
  font-size: clamp(36px, 5vw, 61px);
  line-height: 1.22;
  font-weight: 600;
  letter-spacing: -2.5px;
  color: #f6f8fa;
  margin: 20px 0;
}

.statement-content h2 span {
  color: #c2ad8b;
}

.statement-content p {
  max-width: 425px;
  color: #c2cdd6;
  font-size: 12px;
  line-height: 2;
}

.statement-bottom {
  padding-top: 20px;
  border-top: 1px solid #ffffff25;
}

/* CONTACT */

.contact-section {
  min-height: 530px;
  padding-top: 115px;
  padding-bottom: 115px;
  background: #fafbfb;
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  align-items: center;
  gap: 65px;
}

.contact-decoration {
  position: relative;
  height: 290px;
  display: grid;
  place-items: center;
}

.contact-decoration > span {
  font-family: "Manrope", sans-serif;
  font-size: 150px;
  font-weight: 800;
  color: var(--navy);
  text-shadow: 12px 15px 20px #172f4a25;
  z-index: 2;
}

.contact-orbit {
  position: absolute;
  width: 270px;
  height: 270px;
  border: 1px solid #aab8c3;
  border-radius: 50%;
  transform: rotateX(65deg) rotateZ(-25deg);
}

.orbit-inner {
  width: 215px;
  height: 215px;
  border-color: #bba57e;
  transform: rotateX(65deg) rotateZ(35deg);
}

.contact-copy h2 {
  margin-top: 23px;
  margin-bottom: 22px;
}

.contact-copy p {
  max-width: 420px;
  color: var(--muted);
  font-size: 12px;
  line-height: 2;
  margin-bottom: 28px;
}

/* FOOTER */

.site-footer {
  padding: 32px 7% 22px;
  background: #fff;
  border-top: 1px solid var(--line);
}

.footer-top,
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.footer-top {
  padding-bottom: 28px;
  border-bottom: 1px solid var(--line);
}

.footer-brand {
  color: var(--navy);
  font-family: "Manrope", sans-serif;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -1px;
}

.footer-brand span {
  display: block;
  font-family: "DM Sans", sans-serif;
  font-size: 7px;
  letter-spacing: 3px;
  color: var(--blue);
}

.footer-top > span,
.back-top,
.footer-bottom {
  font-size: 8px;
  letter-spacing: 1.2px;
  color: #8995a0;
}

.back-top {
  font-weight: 700;
  color: var(--navy);
}

.footer-bottom {
  padding-top: 18px;
  font-size: 7px;
}

/* RESPONSIVE */

@media (max-width: 1050px) {
  .main-nav {
    gap: 19px;
  }

  .hero-section {
    grid-template-columns: 1fr 1fr;
    padding-left: 5%;
    padding-right: 5%;
  }

  .hero-copy h1 {
    font-size: clamp(48px, 6vw, 65px);
  }

  .hero-art {
    transform: scale(.88);
  }

  .section-pad {
    padding-left: 7%;
    padding-right: 7%;
  }
}

@media (max-width: 760px) {
  .announcement {
    padding: 0 5%;
  }

  .announcement-right {
    display: none;
  }

  .site-header {
    height: 76px;
    padding: 0 5%;
  }

  .brand-logo {
    max-height: 55px;
  }

  .logo-wrap {
    width: 145px;
  }

  .mobile-menu-button {
    display: block;
    border: 0;
    background: none;
    color: var(--navy);
    font-size: 23px;
    cursor: pointer;
    margin-left: auto;
    margin-right: 20px;
  }

  .main-nav {
    display: none;
    position: absolute;
    top: 75px;
    left: 0;
    right: 0;
    padding: 22px 6%;
    background: white;
    border-bottom: 1px solid var(--line);
    box-shadow: 0 15px 20px #172f4a0b;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .main-nav.nav-open {
    display: flex;
  }

  .main-nav a {
    font-size: 13px;
  }

  .mobile-contact {
    display: block;
  }

  .header-cta {
    padding: 11px;
    gap: 8px;
    font-size: 10px;
  }

  .hero-section {
    grid-template-columns: 1fr;
    padding: 75px 7% 85px;
  }

  .hero-copy h1 {
    font-size: clamp(48px, 10vw, 67px);
    letter-spacing: -3px;
  }

  .hero-art {
    height: 400px;
    transform: none;
    margin-top: 20px;
  }

  .stage-ring {
    width: 290px;
    height: 290px;
  }

  .stage-ring-back {
    width: 330px;
    height: 330px;
  }

  .hero-footer-line span:nth-child(2) {
    display: none;
  }

  .capability-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 28px 7%;
  }

  .about-section {
    grid-template-columns: 1fr;
    gap: 35px;
    padding-top: 85px;
    padding-bottom: 85px;
  }

  .aside-decoration {
    display: none;
  }

  .about-main h2,
  .services-heading h2,
  .contact-copy h2 {
    font-size: 40px;
  }

  .about-bottom {
    display: block;
  }

  .underlined-link {
    display: inline-block;
    margin-top: 23px;
  }

  .services-section {
    padding-top: 85px;
    padding-bottom: 85px;
  }

  .services-heading {
    display: block;
    margin-bottom: 35px;
  }

  .services-heading > p {
    margin-top: 20px;
  }

  .service-row {
    grid-template-columns: 30px 65px 1fr 35px;
    gap: 12px;
    padding: 22px 3px;
  }

  .service-symbol {
    width: 55px;
    height: 55px;
    font-size: 24px;
  }

  .service-content h3 {
    font-size: 17px;
  }

  .service-content p {
    font-size: 10px;
  }

  .service-link {
    width: 32px;
    height: 32px;
    font-size: 14px;
  }

  .statement-section {
    padding: 40px 7%;
    min-height: 500px;
  }

  .statement-content {
    margin: 75px 0;
  }

  .statement-content h2 {
    font-size: 39px;
  }

  .statement-bottom span:last-child {
    display: none;
  }

  .contact-section {
    grid-template-columns: 1fr;
    gap: 30px;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .contact-decoration {
    height: 210px;
  }

  .contact-decoration > span {
    font-size: 115px;
  }

  .contact-orbit {
    width: 210px;
    height: 210px;
  }

  .orbit-inner {
    width: 170px;
    height: 170px;
  }

  .footer-top {
    flex-wrap: wrap;
  }

  .footer-top > span {
    display: none;
  }

  .footer-bottom {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 420px) {
  .hero-buttons {
    align-items: flex-start;
    flex-direction: column;
    gap: 20px;
  }

  .hero-art {
    height: 330px;
  }

  .sculpture {
    transform: scale(.82) rotateY(-30deg) rotateX(13deg) rotateZ(-8deg);
  }

  .stage-ring {
    width: 250px;
    height: 250px;
  }

  .stage-ring-back {
    width: 285px;
    height: 285px;
  }

  .art-top-label,
  .art-bottom-label {
    font-size: 7px;
  }

  .service-row {
    grid-template-columns: 22px 1fr 30px;
  }

  .service-symbol {
    display: none;
  }

  .service-content h3 {
    font-size: 16px;
  }

  .about-main h2,
  .services-heading h2,
  .contact-copy h2 {
    font-size: 34px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    scroll-behavior: auto !important;
    transition: none !important;
  }
}
